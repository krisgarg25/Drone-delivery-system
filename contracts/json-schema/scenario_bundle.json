{
  "$defs": {
    "AltitudeReference": {
      "enum": [
        "AGL",
        "AMSL",
        "GROUND",
        "PAD",
        "UNSPECIFIED"
      ],
      "title": "AltitudeReference",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recursive JSON value type so contract APIs never use ``Any``.",
      "title": "JsonValue"
    },
    "ProtectedVolumePolicy": {
      "additionalProperties": false,
      "description": "Versioned protected-volume margins (illustrative experiment parameters).",
      "properties": {
        "altitude_reference": {
          "$ref": "#/$defs/AltitudeReference",
          "default": "AGL"
        },
        "horizontal_margin_m": {
          "minimum": 0,
          "title": "Horizontal Margin M",
          "type": "integer"
        },
        "illustrative": {
          "default": true,
          "title": "Illustrative",
          "type": "boolean"
        },
        "policy_version": {
          "default": "sim-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "position_uncertainty_m": {
          "minimum": 0,
          "title": "Position Uncertainty M",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timing_uncertainty_s": {
          "minimum": 0,
          "title": "Timing Uncertainty S",
          "type": "integer"
        },
        "transition_buffer_s": {
          "minimum": 0,
          "title": "Transition Buffer S",
          "type": "integer"
        },
        "vertical_margin_m": {
          "minimum": 0,
          "title": "Vertical Margin M",
          "type": "integer"
        }
      },
      "required": [
        "horizontal_margin_m",
        "vertical_margin_m",
        "position_uncertainty_m",
        "timing_uncertainty_s",
        "transition_buffer_s"
      ],
      "title": "ProtectedVolumePolicy",
      "type": "object"
    },
    "ScenarioFault": {
      "additionalProperties": false,
      "properties": {
        "aircraft_ref": {
          "title": "Aircraft Ref",
          "type": "string"
        },
        "at_sim_time_seconds": {
          "minimum": 0,
          "title": "At Sim Time Seconds",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "aircraft_ref",
        "kind",
        "at_sim_time_seconds"
      ],
      "title": "ScenarioFault",
      "type": "object"
    },
    "ScenarioUnits": {
      "additionalProperties": false,
      "properties": {
        "altitude_reference": {
          "$ref": "#/$defs/AltitudeReference",
          "default": "AGL"
        },
        "time_zone": {
          "default": "Asia/Kolkata",
          "title": "Time Zone",
          "type": "string"
        }
      },
      "title": "ScenarioUnits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoritative": {
      "default": false,
      "title": "Authoritative",
      "type": "boolean"
    },
    "demand": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Demand",
      "type": "object"
    },
    "faults": {
      "items": {
        "$ref": "#/$defs/ScenarioFault"
      },
      "title": "Faults",
      "type": "array"
    },
    "fleet": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Fleet",
      "type": "object"
    },
    "network": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Network",
      "type": "object"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtectedVolumePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_manifest": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Source Manifest",
      "type": "object"
    },
    "units": {
      "$ref": "#/$defs/ScenarioUnits",
      "default": {
        "altitude_reference": "AGL",
        "time_zone": "Asia/Kolkata"
      }
    },
    "weather_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Seed"
    }
  },
  "required": [
    "scenario_id"
  ],
  "title": "ScenarioBundle",
  "type": "object"
}
