# Local development only. These values are not secrets and must never be reused
# anywhere a real aircraft, tenant or partner is involved.
#
# Copy to `.env` (git-ignored). Compose reads `.env`; the API reads the same names.
# Rule: no live credentials exist in Phase 0, and the simulator cannot be pointed at a
# vehicle link because no vehicle command module exists to point it at.

# --- local data store (Docker only, bound to 127.0.0.1) -------------------------------
POSTGRES_DB=droneops
POSTGRES_USER=droneops
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Async SQLAlchemy / asyncpg DSN used by `make migrate` and the concurrency tests.
DATABASE_URL=postgresql+asyncpg://droneops:local-development-only@127.0.0.1:5432/droneops
DRONEOPS_TEST_POSTGRES_DSN=postgresql://droneops:local-development-only@127.0.0.1:5432/droneops

VALKEY_URL=valkey://127.0.0.1:6379/0

# --- application ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CONSOLE_PORT=5173
LOG_LEVEL=info
CONFIG_RELEASE_DIR=configs

# --- simulation -----------------------------------------------------------------------
# The runner reads a frozen scenario bundle. There is no live-source mode and there is
# no flag that turns this product into a flight controller.
SIMULATION_SCENARIO_DIR=simulation/scenarios/chandigarh-basic
SIMULATION_SEED=20260930
DRONEOPS_SIMULATION_ONLY=1

# --- intentionally absent ---------------------------------------------------------------
# No container registry credentials, cloud keys, OIDC client secrets or device
# certificates belong in this file. See 07-infrastructure-ci-security.md section 5.
