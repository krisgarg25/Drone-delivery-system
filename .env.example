# Local development only. These values are not secrets and must never be reused
# anywhere a real aircraft, tenant or partner is involved.
#
# Copy to `.env` (git-ignored). Compose reads `.env`; the API reads the same names.
# Rule: no live credentials exist in Phase 0, and the simulator cannot be pointed at a
# vehicle link because no vehicle command module exists to point it at.
#
# Why 55432 and not 5432: a developer machine very often already runs a native
# PostgreSQL service on 5432 (on this workstation it is `postgresql-x64-18`), so the
# default `make db-up` would fail with "address already in use" — or worse, a fresh
# clone would silently target the wrong server. The host ports are therefore pinned
# out of the privileged range: Postgres 55432, Valkey 56379.

# --- local data store (Docker only, bound to 127.0.0.1) -------------------------------
POSTGRES_DB=droneops
POSTGRES_USER=droneops
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Async SQLAlchemy / asyncpg DSN used by `make migrate` and the concurrency tests.
DATABASE_URL=postgresql+asyncpg://droneops:local-development-only@127.0.0.1:55432/droneops
DRONEOPS_DATABASE_URL=postgresql+asyncpg://droneops:local-development-only@127.0.0.1:55432/droneops
DRONEOPS_TEST_POSTGRES_DSN=postgresql://droneops:local-development-only@127.0.0.1:55432/droneops

# Non-superuser application role created by the baseline migration. The runtime connects
# as this role only: row-level security applies to it, and it holds INSERT/SELECT on the
# audit log with no UPDATE/DELETE/TRUNCATE on any append-only table.
DRONEOPS_APP_DB_USER=droneops_app
DRONEOPS_APP_DB_PASSWORD=local-development-only
DRONEOPS_APP_DB_DSN=postgresql://droneops_app:local-development-only@127.0.0.1:55432/droneops

VALKEY_URL=valkey://127.0.0.1:56379/0
VALKEY_PORT=56379

# --- application ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CONSOLE_PORT=5173
LOG_LEVEL=info
CONFIG_RELEASE_DIR=configs

# --- simulation -----------------------------------------------------------------------
# The runner reads a frozen scenario bundle. There is no live-source mode and there is
# no flag that turns this product into a flight controller.
SIMULATION_SCENARIO_DIR=simulation/scenarios/chandigarh-basic
SIMULATION_SEED=20260930
DRONEOPS_SIMULATION_ONLY=1

# --- intentionally absent ---------------------------------------------------------------
# No container registry credentials, cloud keys, OIDC client secrets or device
# certificates belong in this file. See 07-infrastructure-ci-security.md section 5.
